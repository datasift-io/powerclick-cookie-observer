___SANDBOXED_JS_FOR_SERVER___

/**
 * PowerClick Cookie Observer — sGTM Custom Template
 *
 * The canonical PowerClick first-party cookie + observation layer for any
 * tenant's server-side tag manager. Replaces Cookie Monster for setting
 * __spore_* cookies and adds server-side observation reported back to
 * PowerClick for the /cookies dashboard.
 *
 * SCOPE: Lane 1 cookies only (PowerClick __spore_*). This template does
 * not touch native platform cookies (_fbc, _gcl_au, etc. — handled by
 * Stape Cookie Extender or equivalent in Lane 2) or analytics cookies.
 *
 * SETUP: import powerclick-cookie-observer.tpl (Templates → New, or open the
 * existing template → ⋮ → Import). Fields and permissions come with it — never
 * paste this file: hand-made fields don't match the names the code reads.
 * Rebuild the .tpl after editing: python3 gtm-scripts/sgtm/build_observer.py
 *
 * TRIGGER: `powerclick` (the loader's landing hit) plus the tenant's own browser
 * funnel events that reach sGTM (view_item, add_to_cart, begin_checkout, …).
 * Each fire refreshes the cookies the browser sent and reports one observation;
 * repeat fires are safe. No consent gate: a consent-denied visitor has no
 * __spore_* cookies to refresh, and nothing is ever minted here.
 *
 * CANONICAL SCHEMA: docs/POWERCLICK_COOKIE_SCHEMA.md
 */

const getEventData = require('getEventData');
const JSON = require('JSON');
const sendHttpRequest = require('sendHttpRequest');
const queryPermission = require('queryPermission');
// Ingest host. ingest.powerclick.io when this template's "Sends HTTP requests" permission allows it,
// otherwise the legacy ingest host. Both hosts run the same Cloudflare ingest worker, so the
// template works under either permission set and a container moves domains by adding the permission —
// never by a code change. (queryPermission needs no permission of its own.)
const POWERCLICK_INGEST = queryPermission('send_http', 'https://ingest.powerclick.io/api/ingest')
  ? 'https://ingest.powerclick.io/api/ingest'
  : 'https://ingest.clickspore.io/api/ingest';
const getTimestampMillis = require('getTimestampMillis');
const setCookie = require('setCookie');
const getCookieValues = require('getCookieValues');
const decodeUriComponent = require('decodeUriComponent');
const parseUrl = require('parseUrl');
const computeEffectiveTldPlusOne = require('computeEffectiveTldPlusOne');
const getRequestHeader = require('getRequestHeader');
const makeString = require('makeString');

// ─── Schema (mirror of docs/POWERCLICK_COOKIE_SCHEMA.md) ─────────────────────
// max_age in seconds. Never HttpOnly: the loader reads every __spore_* cookie
// (identity and click IDs) on return visits.

const SCHEMA = {
  // Identity cookies — generated by bootstrap on first visit, server preserves on return.
  identity: [
    { name: '__spore_uid', max_age: 34560000, http_only: false },  // 400 days
    { name: '__spore_jid', max_age: 2592000,  http_only: false },  // 30 days
    { name: '__spore_sid', max_age: 1800,     http_only: false },  // 30 minutes
    { name: '__spore_id',  max_age: 172800,   http_only: false }   // 48 hours
  ],
  // Click ID captures — server can read URL itself; bootstrap also writes these as fallback.
  click_ids: [
    { name: '__spore_gclid',   url_param: 'gclid',           max_age: 172800 },
    { name: '__spore_fbclid',  url_param: 'fbclid',          max_age: 172800 },
    { name: '__spore_ttclid',  url_param: 'ttclid',          max_age: 172800 },
    { name: '__spore_msclkid', url_param: 'msclkid',         max_age: 172800 },
    { name: '__spore_tblci',   url_param: 'tblci',           max_age: 172800 },
    { name: '__spore_obclid',  url_param: 'obclid',          max_age: 172800 },
    { name: '__spore_obclid',  url_param: 'OutbrainClickId', max_age: 172800 },  // case-sensitive alias
    { name: '__spore_sc_click_id', url_param: 'sc_click_id', max_age: 172800 },
    { name: '__spore_rdt_cid', url_param: 'rdt_cid',     max_age: 172800 },
    { name: '__spore_epik',    url_param: 'epik',        max_age: 172800 },
    { name: '__spore_oppref',  url_param: 'oppref',      max_age: 172800 }
  ]
};

// ─── Bail conditions ─────────────────────────────────────────────────────────

// Skip GTM preview/debug pings
const url = getEventData('page_location') || getRequestHeader('referer') || '';
if (url && url.lastIndexOf('https://gtm-msr.appspot.com/', 0) === 0) {
  return data.gtmOnSuccess();
}

const cookieDomain = getCookieDomain();
const refreshExisting = data.refreshExisting !== false; // default: true

// ─── Phase 1: Refresh / set identity cookies ─────────────────────────────────
// The loader (bootstrap) is the only source of identity values. We only refresh
// what the browser sent; a missing cookie stays missing.

const identityObservations = [];
for (let i = 0; i < SCHEMA.identity.length; i++) {
  const def = SCHEMA.identity[i];
  const value = getCookieValues(def.name)[0];

  if (value) {
    if (refreshExisting) {
      setCookie(def.name, value, {
        domain: cookieDomain,
        path: '/',
        samesite: 'Lax',
        secure: true,
        'max-age': def.max_age,
        HttpOnly: def.http_only
      });
    }
    identityObservations.push({ name: def.name, present: true, source: 'incoming' });
  } else {
    identityObservations.push({ name: def.name, present: false, source: null });
  }
}

// ─── Phase 2: Capture click_ids from URL (or refresh existing) ───────────────

const urlParsed = url ? parseUrl(url) : null;
const params = (urlParsed && urlParsed.searchParams) || {};

const clickIdObservations = [];
for (let j = 0; j < SCHEMA.click_ids.length; j++) {
  const def = SCHEMA.click_ids[j];
  const fromUrl = params[def.url_param] ? decodeUriComponent(makeString(params[def.url_param])) : null;
  const fromCookie = getCookieValues(def.name)[0] || null;
  const value = fromUrl || fromCookie || null;

  if (value && (fromUrl || refreshExisting)) {
    setCookie(def.name, value, {
      domain: cookieDomain,
      path: '/',
      samesite: 'Lax',
      secure: true,
      'max-age': def.max_age,
      HttpOnly: false
    });
  }
  if (value) {
    clickIdObservations.push({
      name: def.name,
      url_param: def.url_param,
      present: true,
      source: fromUrl ? 'url' : 'incoming'
    });
  }
}

// ─── Phase 3: Observe Lane 2 native platform cookies (read-only) ─────────────
// We don't write these — they belong to platforms and Stape Cookie Extender.
// We *do* observe them so the dashboard can show stack-wide health and detect
// HttpOnly cookies that JS-side measurement can't see.

const NATIVE_OBSERVED = [
  '_fbp', '_fbc',
  '_gcl_au', '_gcl_aw', '_gcl_ag', '_gcl_gb', '_gcl_dc',
  '_ttp',
  '_pin_unauth',
  '_scid',
  '_rdt_uuid',
  '__oppref', '__obref',
  'MUID', '_uetsid', '_uetvid', '_uetmsclkid'
];

const nativeObservations = [];
for (let k = 0; k < NATIVE_OBSERVED.length; k++) {
  const cn = NATIVE_OBSERVED[k];
  const present = !!getCookieValues(cn)[0];
  nativeObservations.push({ name: cn, present: present });
}

// ─── Phase 4: Report observation to PowerClick ───────────────────────────────

const tenantId = data.clicksporeTenantId || 'default';
const ingestUrl = POWERCLICK_INGEST + '?tenant_id=' + tenantId;

const sporeUid = (getCookieValues('__spore_uid')[0]) || null;

const observation = {
  type: 'cookie_observation',
  event: 'cookie_observation',
  ts_ms: getTimestampMillis(),
  event_source: 'sgtm',
  tenant_id: tenantId,
  spore_uid: sporeUid,
  page_url: url || null,
  user_agent: getRequestHeader('user-agent') || null,
  cookies: {
    powerclick_identity: identityObservations,
    powerclick_click_ids: clickIdObservations,
    native: nativeObservations
  }
};

sendHttpRequest(
  ingestUrl,
  { headers: { 'content-type': 'application/json' }, method: 'POST', timeout: 3000 },
  JSON.stringify(observation)
).then(function () {
  data.gtmOnSuccess();
}).catch(function () {
  // Don't fail the tag chain on observation post failure — cookie writes are
  // already committed to the response by this point.
  data.gtmOnSuccess();
});

// ─── Helpers ─────────────────────────────────────────────────────────────────

function getCookieDomain() {
  return computeEffectiveTldPlusOne(url) || 'auto';
}


